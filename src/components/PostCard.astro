---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { Post } from '../utils/posts';
import { formatDate, readingTime } from '../utils/posts';

interface Props {
  post: Post;
  /** Bild sofort laden (für Karten im sichtbaren Bereich). */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const category = await getEntry(post.data.category);
const url = `/blog/${post.id}/`;
---

<article class="card">
  <a href={url} class="cover" tabindex="-1" aria-hidden="true">
    <Image
      src={post.data.cover}
      alt={post.data.coverAlt}
      widths={[400, 640, 960]}
      sizes="(min-width: 1200px) 380px, (min-width: 720px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </a>
  <div class="body">
    <p class="meta">
      {
        category && (
          <>
            <a class="category" href={`/kategorie/${category.id}/`}>
              {category.data.name}
            </a>
            <span aria-hidden="true">·</span>
          </>
        )
      }
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </p>
    <h3><a href={url}>{post.data.title}</a></h3>
    <p class="excerpt">{post.data.description}</p>
    <p class="reading">{readingTime(post.body)} Min. Lesezeit</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .cover {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface-2);
    aspect-ratio: 4 / 3;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .cover img {
    transform: scale(1.05);
  }
  .body {
    padding-top: 1.1rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .category {
    position: relative;
    z-index: 1;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--color-accent);
    text-decoration: none;
  }
  .category:hover {
    text-decoration: underline;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.45rem;
  }
  h3 a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s ease;
  }
  /* Die ganze Karte ist klickbar */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover h3 a {
    background-size: 100% 1px;
  }
  .excerpt {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .reading {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
