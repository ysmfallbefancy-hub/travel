---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { SITE } from '../../consts';
import { getPosts } from '../../utils/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage > 1 ? `Blog – Seite ${page.currentPage}` : 'Blog'}
  description="Alle Reiseberichte und Tipps auf einen Blick."
>
  <header class="page-header container">
    <h1>Alle Beiträge</h1>
    <p>Reiseberichte, Tipps und Geschichten von unterwegs.</p>
  </header>
  <section class="container">
    <div class="post-grid">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>
    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      current={page.currentPage}
      last={page.lastPage}
    />
  </section>
</BaseLayout>
