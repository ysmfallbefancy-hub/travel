---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum">
  <header class="page-header container">
    <h1>Impressum</h1>
  </header>
  <section class="container prose">
    <p><strong>Platzhalter:</strong> Bitte durch die gesetzlich vorgeschriebenen Angaben ersetzen (§ 5 DDG).</p>
    <h2>Angaben gemäß § 5 DDG</h2>
    <p>Vorname Nachname<br />Straße Hausnummer<br />PLZ Ort</p>
    <h2>Kontakt</h2>
    <p>E-Mail: kontakt@example.com</p>
  </section>
</BaseLayout>
