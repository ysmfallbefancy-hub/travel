---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p !== featured).slice(0, 6);
const categories = await getCollection('categories');
---

<BaseLayout>
  <section class="hero container">
    <h1>{SITE.title}</h1>
    <p>{SITE.tagline}</p>
  </section>

  {
    featured && (
      <section class="container">
        <h2 class="sr-only">Empfohlener Beitrag</h2>
        <div class="post-grid">
          <PostCard post={featured} />
        </div>
      </section>
    )
  }

  <section class="container">
    <h2>Neueste Beiträge</h2>
    <div class="post-grid">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
    <p><a href="/blog/">Alle Beiträge ansehen →</a></p>
  </section>

  <section class="container">
    <h2>Kategorien</h2>
    <ul class="categories">
      {
        categories.map((c) => (
          <li>
            <a href={`/kategorie/${c.id}/`}>{c.data.name}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 4rem 1rem;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0;
  }
  .hero p {
    color: var(--color-muted);
    font-size: 1.2rem;
  }
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }
  .categories a {
    display: inline-block;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    background: var(--color-surface);
  }
</style>
