---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const categories = (await getCollection('categories'))
  .map((c) => {
    const inCategory = posts.filter((p) => p.data.category.id === c.id);
    return { ...c, count: inCategory.length, cover: inCategory[0]?.data.cover };
  })
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'de'));
---

<BaseLayout title="Kategorien" description="Alle Themen des Blogs auf einen Blick.">
  <header class="page-header container">
    <span class="eyebrow">Themen</span>
    <h1>Kategorien</h1>
    <p>Stöbere nach Reiseziel oder Thema.</p>
  </header>
  <section class="container">
    <ul class="list">
      {
        categories.map((c) => (
          <li>
            <a href={`/kategorie/${c.id}/`}>
              <div class="thumb">
                {c.cover && (
                  <Image
                    src={c.cover}
                    alt=""
                    widths={[400, 640, 960]}
                    sizes="(min-width: 1200px) 380px, (min-width: 720px) 50vw, 100vw"
                  />
                )}
              </div>
              <div class="text">
                <h2>{c.data.name}</h2>
                <p>{c.data.description}</p>
                <span class="count">{c.count === 1 ? '1 Beitrag' : `${c.count} Beiträge`} →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 2rem;
    list-style: none;
    padding: 1rem 0 2rem;
    margin: 0;
  }
  .list a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .list a:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover));
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .list a:hover img {
    transform: scale(1.05);
  }
  .text {
    padding: 1.5rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.6rem;
  }
  p {
    margin: 0 0 1rem;
    color: var(--color-muted);
  }
  .count {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
