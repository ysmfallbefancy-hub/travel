---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBar from '../../components/CategoryBar.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const categories = await getCollection('categories');
  const posts = await getPosts();
  return categories.map((category) => ({
    params: { slug: category.id },
    props: { category, posts: posts.filter((p) => p.data.category.id === category.id) },
  }));
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props;
---

<BaseLayout title={category.data.name} description={category.data.description}>
  <header class="page-header container">
    <span class="eyebrow">Kategorie · {posts.length === 1 ? '1 Beitrag' : `${posts.length} Beiträge`}</span>
    <h1>{category.data.name}</h1>
    <p>{category.data.description}</p>
  </header>
  <CategoryBar active={category.id} />
  <section class="container">
    {
      posts.length > 0 ? (
        <div class="post-grid listing">
          {posts.map((post, i) => (
            <PostCard post={post} eager={i < 3} />
          ))}
        </div>
      ) : (
        <p class="empty listing">In dieser Kategorie gibt es noch keine Beiträge.</p>
      )
    }
  </section>
</BaseLayout>
